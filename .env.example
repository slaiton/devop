# Postgres - rol admin (dueno de las tablas; solo lo usan las migraciones)
POSTGRES_PASSWORD=changeme-admin
MIGRATIONS_DATABASE_URL=postgresql://devsentinel:changeme-admin@postgres:5432/devsentinel

# Postgres - rol de aplicacion (sin privilegios de owner; el que de verdad queda
# sujeto a Row-Level Security). Si cambias una de estas dos lineas, cambia la otra.
APP_DB_PASSWORD=changeme-app
DATABASE_URL=postgresql://devsentinel_app:changeme-app@postgres:5432/devsentinel

# Redis
REDIS_URL=redis://redis:6379

# Sesion (firma los JWT de sesión Y los tokens de un solo uso para "conectar una cuenta
# de GitHub" desde /accounts — no lo cambies sin necesidad, invalida todas las sesiones
# activas al rotarlo)
JWT_SECRET=changeme

# Cifra en reposo los secretos guardados en system_settings (LLM, SMTP) y en github_apps
# (credenciales de cada GitHub App conectada — ver /settings y /accounts una vez
# logueado). Generar con: openssl rand -hex 32
# Si se pierde o se cambia, los secretos ya guardados quedan ilegibles y hay que
# volver a escribirlos desde la UI.
CONFIG_ENCRYPTION_KEY=

# Dominio publico (Caddy emite HTTPS automatico via Let's Encrypt para este host).
# El login (correo/contraseña) y las GitHub Apps (App ID, slug, claves, etc.) ya no
# dependen de variables de entorno — se gestionan desde /setup, /settings y /accounts.
# Al crear una GitHub App en github.com, su "Setup URL" (con "Redirect on update"
# activado) debe apuntar a ${PUBLIC_WEB_ORIGIN}/api/github-apps/callback.
PUBLIC_DOMAIN=devsentinel.example.com
PUBLIC_WEB_ORIGIN=https://devsentinel.example.com

# URL interna del api dentro de la red de Docker Compose (usada por web en el servidor,
# sin pasar por Caddy). El prefijo /api ya queda incluido por setGlobalPrefix en Nest.
API_INTERNAL_URL=http://api:3000
